# Copie para .env se quiser (ou configure estas variáveis no painel da hospedagem).
PORT=3000
NODE_ENV=production
# Pasta onde ficam o banco e as imagens enviadas. Em hospedagem na nuvem, aponte para um disco persistente (ex.: /var/data).
DATA_DIR=./data
# Usuário e senha do login do grupo. Só valem na PRIMEIRA vez que o site sobe. Depois, use: npm run trocar-senha
ADMIN_USER=infopathos
ADMIN_PASSWORD=  # defina uma senha forte aqui (ou no painel da hospedagem). Nunca publique o arquivo .env
